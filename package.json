{
  "name": "classificador-ncm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fontes": "python3 scripts/baixar_fontes.py",
    "dados": "python3 scripts/pipeline.py",
    "build:dados": "npm run fontes && npm run dados",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build:reforma": "python3 scripts/baixar_reforma.py && python3 scripts/baixar_is.py && python3 scripts/pipeline.py",
    "reforma": "python3 scripts/baixar_reforma.py",
    "ui:test": "node scripts/ui-smoke.mjs",
    "erp": "python3 scripts/baixar_erp.py && python3 scripts/pipeline.py"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "next": "16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0"
  }
}
