# Copie para .env.local (NÃO commitar .env.local).

# --- IA (rotas /api/classificar-ia e /api/auditoria-entrada) ---
GEMINI_API_KEY=
# Modelos em ordem de prioridade, separados por vírgula (o próximo é tentado se o anterior falhar).
# Se vazio, usa o padrão definido em lib/ai/config.ts.
GEMINI_MODELS=
# Limite por IP nas rotas de IA (requisições por minuto). Padrão: 20.
RATE_LIMIT_PER_MIN=20

# --- Atualização de dados (POST /api/atualizar) ---
# DESLIGADA por padrão. Habilite só em servidor com disco persistente e Python (não em Colab/serverless).
ENABLE_UPDATE_ROUTE=false
# Obrigatório quando habilitada. Envie como "Authorization: Bearer <token>".
UPDATE_TOKEN=

# --- Iframes ---
# Origens extras autorizadas a embutir o app (Content-Security-Policy: frame-ancestors).
# Padrão: apenas o próprio site. Ex.: https://preview.exemplo.com https://outro.exemplo.com
FRAME_ANCESTORS=
